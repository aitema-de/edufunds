# Temporaere Outputs (Smoke-Tests, A/B-Vergleiche)
tmp/

# Eval-Lauf-Artefakte (transient, je Live-Run neu erzeugt)
# Korpus selbst (data/eval/matcher-korpus.json) bleibt versioniert.
# Versionierte Baselines kommen separat in data/eval/BASELINE.md (Plan 01-02).
data/eval/reports/
data/eval/snapshots/

# Phase 5 Pipeline-Eval (analog Phase-1-Pattern)
# pipeline-snapshots/baseline/ ist force-committed als Replay-Anker
/data/eval/pipeline-snapshots/*
!/data/eval/pipeline-snapshots/baseline/
/data/eval/pipeline-reports/

# WIZ-05 Gutachter-Eval: Berichte sind generiert (wie pipeline-reports/), die
# Baseline-Zahlen stehen in BASELINE.md. Der Laien-Vergleichsarm
# (data/eval/laien-antraege/) ist dagegen VERSIONIERT — er ist LLM-erzeugt und
# waere sonst bei jeder Neugenerierung ein anderer Massstab.
/data/eval/gutachter-reports/

# WIZ-06 simulierter Nutzer: die Laeufe sind transient (je Lauf neu erzeugt), der
# `baseline/`-Lauf ist force-committed als Vergleichsanker — analog zu
# pipeline-snapshots/baseline/. Die Personenprofile (data/eval/simuser-profile.json)
# sind dagegen VERSIONIERT: sie sind der Massstab selbst. Wuerden sie bei jedem Lauf
# neu erzeugt, vergliche man hinterher zwei verschiedene Personen miteinander.
/data/eval/simuser-runs/*
!/data/eval/simuser-runs/baseline/
!/data/eval/simuser-runs/korpus-baseline.json

# Claude Code local settings (personal allowlist)
.claude/settings.local.json
.claude/worktrees/

# Test-&-Fix-Loop Artefakte
/test-results/
/.planning/test-fix/*-results.json
/.planning/test-fix/wizard-outputs/
playwright-report/
.last-run.json

# Windows/WSL NTFS alternate-data-stream cruft
*:Zone.Identifier

# Wegwerf-Playwright-Skripte aus Demo-/Screenshot-Sessions (gehoeren nicht ins Repo)
_shoot*.cjs

# Laufartefakte des Auto-Pflege-Wochenlaufs (werden als CI-Artifact hochgeladen, nie committet)
failure-report.md
logs/auto-pflege-*/
